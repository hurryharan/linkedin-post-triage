{
  "manifest_version": 3,
  "name": "LinkedIn Post Triage",
  "version": "0.7.0",
  "description": "Classify and review saved LinkedIn posts one at a time, then export for action elsewhere.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "sidePanel", "downloads"],
  "host_permissions": ["*://*.linkedin.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkedIn Post Triage"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/my-items/saved-posts/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
